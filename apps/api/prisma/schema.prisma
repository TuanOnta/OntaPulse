generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum ScanStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ScanKind {
  HTTP_PROBE
  SECURITY_POSTURE
  DNS_WATCH
}

enum FindingCategory {
  HEADERS
  COOKIES
  CORS
  REDIRECT
  TLS
  EXPOSED_FILES
  DNS
  EMAIL_AUTH
}

enum FindingConfidence {
  LOW
  MEDIUM
  HIGH
}

enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum OutboxEventStatus {
  PENDING
  PUBLISHING
  PUBLISHED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  name         String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspaceMemberships   WorkspaceMember[]
  acknowledgedPathProbes MonitorCheckSettings[] @relation("PathProbeAcknowledgedBy")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  WorkspaceMember[]
  projects Project[]
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@unique([workspaceId], where: { role: "OWNER" }, map: "WorkspaceMember_single_owner")
  @@index([userId])
  @@index([workspaceId, role])
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monitors  Monitor[]

  @@index([workspaceId])
}

model Monitor {
  id              String   @id @default(uuid()) @db.Uuid
  projectId       String   @db.Uuid
  name            String
  targetUrl       String
  intervalSeconds Int      @default(300)
  isActive        Boolean  @default(true)
  nextScheduledAt DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scans         Scan[]
  checkSettings MonitorCheckSettings?

  @@unique([projectId, targetUrl])
  @@index([projectId])
  @@index([isActive, nextScheduledAt])
}

model MonitorCheckSettings {
  id                         String    @id @default(uuid()) @db.Uuid
  monitorId                  String    @unique @db.Uuid
  securityPostureEnabled     Boolean   @default(false)
  dnsWatchEnabled            Boolean   @default(false)
  pathProbesEnabled          Boolean   @default(false)
  pathProbesAcknowledgedById String?   @db.Uuid
  pathProbesAcknowledgedAt   DateTime?
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  monitor                  Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  pathProbesAcknowledgedBy User?   @relation("PathProbeAcknowledgedBy", fields: [pathProbesAcknowledgedById], references: [id], onDelete: SetNull)

  @@index([pathProbesAcknowledgedById])
}

model Scan {
  id             String     @id @default(uuid()) @db.Uuid
  monitorId      String     @db.Uuid
  kind           ScanKind   @default(HTTP_PROBE)
  status         ScanStatus @default(QUEUED)
  statusCode     Int?
  responseTimeMs Int?
  errorMessage   String?
  subChecks      Json?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime   @default(now())

  monitor      Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  findings     ScanFinding[]
  outboxEvents ScanOutboxEvent[]

  @@index([monitorId, createdAt])
}

model ScanOutboxEvent {
  id          String            @id @default(uuid()) @db.Uuid
  scanId      String            @unique @db.Uuid
  monitorId   String            @db.Uuid
  status      OutboxEventStatus @default(PENDING)
  attempts    Int               @default(0)
  lastError   String?
  claimedAt   DateTime?
  publishedAt DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model OperationsAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String
  actor     String
  details   Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

model ScanFinding {
  id             String             @id @default(uuid()) @db.Uuid
  scanId         String             @db.Uuid
  code           String
  checkId        String?
  category       FindingCategory?
  confidence     FindingConfidence?
  title          String
  severity       FindingSeverity
  description    String
  recommendation String?
  evidence       Json?
  createdAt      DateTime           @default(now())

  scan Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId, severity])
}
